{
  "name": "masil",
  "productName": "마실",
  "version": "0.1.5",
  "description": "네이버 블로그 이웃집 한 바퀴 도는 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "minipaper",
  "license": "MIT",
  "homepage": "https://github.com/minipaper/masil",
  "repository": {
    "type": "git",
    "url": "https://github.com/minipaper/masil.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.1",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@fontsource-variable/hahmlet": "^5.3.0",
    "@fontsource/gamja-flower": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
